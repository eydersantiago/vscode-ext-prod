{
  "name": "adaceen",
  "displayName": "ADACEEN",
  "description": "Lee archivos del workspace y prepara contexto para análisis en VS Code y Codespaces",
  "version": "0.0.1",
  "publisher": "1",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "contributes": {
    "commands": [
      {
        "command": "adaceen.scanWorkspace",
        "title": "ADACEEN: Escanear workspace"
      }
    ],
    "configuration": {
      "title": "ADACEEN",
      "properties": {
        "adaceen.scan.mode": {
          "type": "string",
          "enum": [
            "auto",
            "local",
            "codespace",
            "all"
          ],
          "default": "auto",
          "description": "Modo de escaneo: detección automática, solo local, solo Codespace/remoto o todo."
        },
        "adaceen.scan.includeGlob": {
          "type": "string",
          "default": "**/*.{ts,tsx,js,jsx,mjs,cjs,py,java,cpp,c,h,hpp,cs,go,rs,php,rb,md,json,yml,yaml,html,css,scss,sql,xml}",
          "description": "Glob de inclusión para los archivos a escanear."
        },
        "adaceen.scan.excludeGlob": {
          "type": "string",
          "default": "**/{node_modules,.git,dist,build,out,coverage,.next,target,bin,obj,vendor,__pycache__}/**",
          "description": "Glob de exclusión para evitar carpetas pesadas o generadas."
        },
        "adaceen.scan.maxFiles": {
          "type": "number",
          "minimum": 1,
          "default": 200,
          "description": "Número máximo de archivos a leer por escaneo."
        },
        "adaceen.scan.maxFileKB": {
          "type": "number",
          "minimum": 1,
          "default": 300,
          "description": "Tamaño máximo por archivo en KB."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "@types/vscode": "^1.96.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.23.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.28.0",
    "webpack": "^5.99.7",
    "webpack-cli": "^6.0.1"
  }
}
